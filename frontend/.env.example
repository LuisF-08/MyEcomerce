# Copie para frontend/.env (desenvolvimento local)

VITE_API_URL=http://localhost:8000/api

# Deploy separado na Vercel (frontend em um projeto, backend em outro):
# No painel Vercel → Project → Settings → Environment Variables:
#   VITE_API_URL = https://SEU-BACKEND.vercel.app/api
# Depois faça um novo deploy (rebuild) do frontend.

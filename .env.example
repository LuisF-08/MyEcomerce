# Copie para .env na raiz do projeto (backend Django).
# No frontend, use frontend/.env.example → frontend/.env para desenvolvimento local.

# Obrigatório — gere uma chave aleatória longa
SECRET_KEY=altere-para-uma-chave-secreta-aleatoria

# Local: True | Produção (Vercel): False
DEBUG=True

# Inclua .vercel.app ou seu domínio customizado na Vercel
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# URL pública do frontend (SPA na Vercel) — usada em CORS/CSRF
FRONTEND_URL=http://localhost:5173

# Opcional: origens extras separadas por vírgula
# CORS_ALLOWED_ORIGINS=https://outro-dominio.vercel.app

# True só em dev; em produção use False e confie em FRONTEND_URL + CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS=True

# Neon / PostgreSQL (obrigatório na Vercel — use connection string pooled, host *-pooler*)
DATABASE_URL=postgresql://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require

# Opcional — cache Redis (Upstash ou docker local)
REDIS_URL=
